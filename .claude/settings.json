{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-lint.sh",
            "timeout": 300,
            "statusMessage": "Lint gate: ktlintCheck"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-push-tests.sh",
            "timeout": 600,
            "statusMessage": "Test gate: unit tests before push"
          }
        ]
      }
    ]
  }
}
